# Copy to .env and adjust. Every variable here is PUBLIC: it is inlined into the client bundle,
# so never put a secret in it.

# Where mail data comes from: "mock" (seeded IndexedDB, Phase 1) or "api" (apps/api, Phase 2).
# Empty: "api" when PUBLIC_API_URL is set, else "mock".
PUBLIC_DATA_SOURCE=

# Base URL of the Phase 2 API, e.g. http://localhost:8080/api/v1. Required when PUBLIC_DATA_SOURCE=api.
PUBLIC_API_URL=

# Version shown on the About page. Defaults to the version in package.json when empty.
PUBLIC_APP_VERSION=
