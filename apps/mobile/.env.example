# Copy to .env and adjust. Every variable here is PUBLIC: it is inlined into the client bundle,
# so never put a secret in it.

# Where mail data comes from: "mock" (seeded IndexedDB, Phase 1) or "api" (apps/api, Phase 2).
PUBLIC_DATA_SOURCE=mock

# Base URL of the Phase 2 API, e.g. http://localhost:5174/api/v1. Required when PUBLIC_DATA_SOURCE=api.
PUBLIC_API_URL=

# Version shown on the About page. Defaults to 0.0.0-dev when empty.
PUBLIC_APP_VERSION=
