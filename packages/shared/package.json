{
  "name": "@nem/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain types, Zod schemas, API contracts and pure utilities for Nem Mail.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:export": "tsx scripts/export-seed.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
